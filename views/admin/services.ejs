<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Services — NIMORA Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="dash-header" style="border-bottom:2px solid #ec4899">
  <a href="/admin" class="logo">👑 NIMORA ADMIN</a>
  <div><a href="/admin" style="color:#06b6d4;text-decoration:none">← Back</a></div>
</div>

<div class="container">
  <h2 style="font-family:Orbitron;margin-bottom:20px">Manage Services</h2>

  <div class="card" style="margin-bottom:30px">
    <h3>➕ Add New Service</h3>
    <form method="POST" action="/admin/services" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-top:14px">
      <input name="category" placeholder="Category (TikTok)" required style="padding:10px;background:#0b0b16;color:#fff;border:1px solid #8b5cf6;border-radius:10px">
      <input name="name" placeholder="Service Name" required style="padding:10px;background:#0b0b16;color:#fff;border:1px solid #8b5cf6;border-radius:10px">
      <input name="price_per_1000" type="number" step="0.01" placeholder="Price / 1000" required style="padding:10px;background:#0b0b16;color:#fff;border:1px solid #8b5cf6;border-radius:10px">
      <input name="min_qty" type="number" placeholder="Min Qty" value="100" style="padding:10px;background:#0b0b16;color:#fff;border:1px solid #8b5cf6;border-radius:10px">
      <input name="max_qty" type="number" placeholder="Max Qty" value="100000" style="padding:10px;background:#0b0b16;color:#fff;border:1px solid #8b5cf6;border-radius:10px">
      <button class="btn" type="submit">Add</button>
    </form>
  </div>

  <table>
    <tr><th>ID</th><th>Category</th><th>Name</th><th>Price/1000</th><th>Min</th><th>Max</th><th>Status</th><th>Actions</th></tr>
    <% services.forEach(s => { %>
      <tr>
        <td>#<%= s.id %></td>
        <td><%= s.category %></td>
        <td><%= s.name %></td>
        <td>$<%= s.price_per_1000.toFixed(2) %></td>
        <td><%= s.min_qty %></td>
        <td><%= s.max_qty %></td>
        <td><%= s.active ? '✅ Active' : '❌ Off' %></td>
        <td style="display:flex;gap:6px">
          <form method="POST" action="/admin/services/<%= s.id %>/toggle"><button class="btn" style="padding:5px 10px;font-size:12px">Toggle</button></form>
          <form method="POST" action="/admin/services/<%= s.id %>/delete"><button class="btn" style="padding:5px 10px;font-size:12px;background:linear-gradient(90deg,#ef4444,#ec4899)">Delete</button></form>
        </td>
      </tr>
    <% }) %>
  </table>
</div>
</body>
</html>
