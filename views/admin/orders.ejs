<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Orders — NIMORA Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="dash-header" style="border-bottom:2px solid #ec4899">
  <a href="/admin" class="logo">👑 NIMORA ADMIN</a>
  <div><a href="/admin" style="color:#06b6d4;text-decoration:none">← Back</a></div>
</div>

<div class="container">
  <h2 style="font-family:Orbitron;margin-bottom:20px">All Orders</h2>
  <table>
    <tr><th>ID</th><th>User</th><th>Service</th><th>Link</th><th>Qty</th><th>Cost</th><th>Status</th><th>Update</th></tr>
    <% orders.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><%= o.username %></td>
        <td><%= o.service_name %></td>
        <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= o.link %></td>
        <td><%= o.quantity %></td>
        <td>$<%= o.cost.toFixed(4) %></td>
        <td><span class="status <%= o.status %>"><%= o.status %></span></td>
        <td>
          <form method="POST" action="/admin/orders/<%= o.id %>/status" style="display:flex;gap:6px">
            <select name="status" style="padding:6px;background:#0b0b16;color:#fff;border:1px solid #8b5cf6;border-radius:8px">
              <option <%= o.status==='pending'?'selected':'' %>>pending</option>
              <option <%= o.status==='processing'?'selected':'' %>>processing</option>
              <option <%= o.status==='completed'?'selected':'' %>>completed</option>
              <option <%= o.status==='cancelled'?'selected':'' %>>cancelled</option>
            </select>
            <button class="btn" style="padding:6px 12px;font-size:12px">Save</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</div>
</body>
</html>
