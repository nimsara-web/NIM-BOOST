<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>New Order — NIMORA BOOST</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="dash-header">
  <a href="/user" class="logo">⚡ NIMORA BOOST</a>
  <div><a href="/user" style="color:#06b6d4;text-decoration:none">← Back</a></div>
</div>

<div class="form-box">
  <h2>NEW ORDER</h2>

  <% if(typeof error !== 'undefined' && error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>
  <% if(typeof success !== 'undefined' && success) { %>
    <div class="alert success"><%= success %></div>
  <% } %>

  <form method="POST" action="/user/new-order" id="orderForm">
    <select name="service_id" required>
      <option value="" disabled selected>-- Select Service --</option>
      <% if(services && services.length > 0) { %>
        <% services.forEach(s => { %>
          <option value="<%= s._id %>">
            <%= s.category %> — <%= s.name %> ($<%= s.price_per_1000.toFixed(2) %>/1000)
          </option>
        <% }) %>
      <% } %>
    </select>

    <input type="url" name="link" placeholder="https://tiktok.com/@user/video/..." required>

    <input type="number" name="quantity" placeholder="Quantity" min="1" required>

    <button class="btn" type="submit">Place Order 🚀</button>
  </form>

  <p style="text-align:center;margin-top:18px;color:#9ca3af;font-size:13px">
    💰 Your balance will be deducted automatically
  </p>
</div>

<script>
  // Client-side validation
  document.getElementById('orderForm').addEventListener('submit', function(e) {
    const service = document.querySelector('select[name="service_id"]').value;
    if (!service) {
      e.preventDefault();
      alert('Please select a service');
      return false;
    }
    const link = document.querySelector('input[name="link"]').value;
    if (!link || link.trim() === '') {
      e.preventDefault();
      alert('Please enter a link');
      return false;
    }
    const qty = document.querySelector('input[name="quantity"]').value;
    if (!qty || qty <= 0) {
      e.preventDefault();
      alert('Please enter a valid quantity');
      return false;
    }
  });
</script>
</body>
</html>
