# ============================================
# NIMORA BOOST — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values.
# ⚠️ NEVER commit the real `.env` file to GitHub!
# ============================================

# ============ SERVER ============
PORT=3000
NODE_ENV=development

# ============ SECURITY ============
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_this_to_random_64_char_string

# ============ DATABASE (MongoDB Atlas) ============
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nimora?retryWrites=true&w=majority

# ============ SMM PROVIDER (SMM Africa v3) ============
# API endpoint URL — SMM Africa API v3
SMM_PROVIDER_URL=https://smm.africa/api/v3

# API Key from SMM Africa → Account → API (keep this SECRET!)
SMM_PROVIDER_KEY=your_smm_africa_api_key_here
